## Creating the KIND Cluster
nano config.yaml

kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4

nodes:
  - role: control-plane
    image: kindest/node:v1.35.1

  - role: worker
    image: kindest/node:v1.35.1

  - role: worker
    image: kindest/node:v1.35.1

  - role: worker
    image: kindest/node:v1.35.1

## Create the cluster
kind create cluster --config config.yaml --name my-cluster
docker ps
kubectl get nodes
kubectl cluster-info
kubectl get pods -A
kubectl get namespaces
kubectl get deployments -A
kubectl get services -A

## Installing Kubernetes Dashboard
## Deploy Dashboard
kubectl apply -f https://raw.githubusercontent.com/kubernetes/dashboard/v2.7.0/aio/deploy/recommended.yaml

## Verify Dashboard Pods
kubectl get pods -n kubernetes-dashboard
kubectl get svc -n kubernetes-dashboard

## Creating Dashboard Admin User
nano dashboard-admin-user.yml

file:
apiVersion: v1
kind: ServiceAccount
metadata:
  name: admin-user
  namespace: kubernetes-dashboard

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: admin-user
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: admin-user
  namespace: kubernetes-dashboard

## Apply the configuration
kubectl apply -f dashboard-admin-user.yml

## Verify ServiceAccount
kubectl get serviceaccount -n kubernetes-dashboard

## Generate the authentication token
kubectl -n kubernetes-dashboard create token admin-user

This generates a bearer token.
Copy it securely.

## Accessing Kubernetes Dashboard
Now access the Dashboard through the browser.
## Start kubectl proxy
kubectl proxy --address=127.0.0.1 --port=8001

## Open Dashboard
http://localhost:8001/api/v1/namespaces/kubernetes-dashboard/services/https:kubernetes-dashboard:/proxy/

